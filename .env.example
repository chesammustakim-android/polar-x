# POLAR-X Backend Environment Configuration
# Copy this file to .env and fill in values for your deployment.
# Lines beginning with # are comments and are ignored.

# ─── FastAPI / Uvicorn ───────────────────────────────────────────────────────
# Bind host. Use 0.0.0.0 to accept connections from all network interfaces.
HOST=0.0.0.0

# Bind port. Cloud platforms often override this with their own $PORT env var.
PORT=8000

# Number of uvicorn worker processes.
# IMPORTANT: Keep at 1 when using SQLite (SQLite is single-writer).
# Increase only when using PostgreSQL / other multi-writer databases.
WORKERS=1

# Log verbosity: debug | info | warning | error | critical
LOG_LEVEL=info

# Set RELOAD=1 only during local development (enables hot-reload).
RELOAD=0

# ─── Database ────────────────────────────────────────────────────────────────
# Default: SQLite file inside the backend/ directory.
# For production with PostgreSQL:
#   DATABASE_URL=postgresql://user:password@host:5432/polar_x
DATABASE_URL=sqlite:///./backend/polar_x.db

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the CORS middleware.
# Use * to allow all origins (suitable for public demo / hackathon judging).
# For tighter security set your exact frontend URL(s):
#   CORS_ORIGINS=https://polar-x.your-domain.com
CORS_ORIGINS=*

# ─── Frontend (Vite build-time variable) ─────────────────────────────────────
# Set this to the PUBLIC URL where FastAPI is reachable.
# This value is baked into the frontend JS bundle at build time.
# Examples:
#   VITE_API_BASE_URL=https://polar-x-api.your-domain.com   (separate backend domain)
#   VITE_API_BASE_URL=https://polar-x.your-domain.com       (same domain – FastAPI serves frontend)
#   VITE_API_BASE_URL=http://127.0.0.1:8000                 (local dev)
VITE_API_BASE_URL=http://127.0.0.1:8000
