# ─── npm / Node ──────────────────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite production build output
# NOTE: Remove 'dist' from this list if your deploy platform requires a pre-built
# dist/ folder committed to the repo (e.g. Render static site, some PaaS).
dist
dist-ssr

# ─── Environment / secrets ───────────────────────────────────────────────────
# Track .env.example (template), but never commit actual .env with secrets
.env
.env.local
.env.*.local
# DO NOT add .env.example – that must be tracked

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info
.eggs
*.egg
venv/
.venv/
env/
.env/

# Python test databases (ephemeral)
test_task*.db

# ─── Editor ──────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# Local application database
*.db
